    "test:engine": "node scripts/engine-tests.mjs",
    "test:film-depth": "node scripts/film-depth-tests.mjs",
    "test:film-backend": "node scripts/film-backend-tests.mjs",
    "test:film-backend:browser": "playwright test scripts/browser/film-backend.spec.ts",
    "export:animatic": "node tools/export-animatic.mjs",
    "test:validator": "node scripts/validator-audit.mjs",
    "test:dom": "node scripts/dom-smoke.mjs",
    "test:image-picker": "node scripts/beta/image-picker-harness.mjs",
    "test:audio-picker": "node scripts/beta/audio-picker-harness.mjs",
    "perf:studio": "node scripts/studio-perf.mjs",
    "test:foreground": "node scripts/beta/foreground-harness.mjs",
    "test:media": "node scripts/ie-roundtrip/run.mjs",
    "test:media:real": "node scripts/ie-roundtrip/real-file.mjs",
    "preflight": "node scripts/preflight.mjs",
    "bot": "node scripts/playthrough-bot.mjs",
    "desktop:preview": "npm run build && electron .",
    "desktop:dev": "npm run build && electron .",
    "desktop:dev-live": "node scripts/desktop-dev.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:preview:fullscreen": "npm run build && electron . --fullscreen",
    "test:studio-beta": "node scripts/beta/studio-beta-harness.mjs",
    "test:sprites": "node scripts/sprite-key-tests.mjs",
    "test:sprite-atlas": "node scripts/sprite-atlas-tests.mjs",
    "test:sledge": "node scripts/beta/sledge-harness.mjs",
    "test:sledge-dom": "node scripts/beta/sledge-dom.mjs",
    "test:arcade": "node scripts/beta/arcade-harness.mjs",
    "test:gadget": "node scripts/beta/gadget-harness.mjs",
    "test:scooby": "node scripts/beta/scooby-harness.mjs",
    "test:screel": "node scripts/screel-tests.mjs",
    "test:studio-ship": "node scripts/studio-ship-tests.mjs",
    "test:browser": "playwright test",
    "test:black-mass-bride": "node scripts/black-mass-bride-tests.mjs",
    "art:plates": "node scripts/art-room/plate-opt.mjs",
    "art:plates:check": "node scripts/art-room/plate-opt.mjs --check public/assets --fail-over 400",
    "art:cold-open": "node tools/cold-open-prompts.mjs pack --write",
    "art:retakes": "node tools/retake-reel-pictures.mjs hangar"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "@xyflow/react": "^12.11.3",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.12.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Scarlet Reel desktop game shell",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.scarletreel.pulpengine",
    "productName": "Scarlet Reel",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Game",
      "target": [
        "AppImage"
      ]
    }
  },
  "author": "sigooding"
}
